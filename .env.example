# Server URL, read at runtime by the /api proxy (never exposed to the browser).
API_URL=http://localhost:8000
# Used by `pnpm gen:api` only: a path or URL to the server's openapi.json.
OPENAPI_SOURCE=../mail-assistant-server/openapi.json
# Developer /eval page: path to the server's scenario results (default shown).
# EVAL_RESULTS_PATH=../mail-assistant-server/tests/scenarios/results/latest.json
